<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="MonitorPin.app" />

  <!-- Run at the invoking user's integrity level. Elevation is handled by the
       Task Scheduler logon task (highest privileges), not a manifest requirement,
       so there's no UAC prompt on every launch. -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <!-- DPI awareness (PerMonitorV2) is configured via the ApplicationHighDpiMode
       project property, applied by ApplicationConfiguration.Initialize(). -->

  <!-- Declare Windows 10/11 compatibility so version-gated APIs behave. -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
</assembly>
